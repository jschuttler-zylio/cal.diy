{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://withzylio.dev/schemas/booking/scheduler.v1.schema.json",
  "title": "Source-derived Cal.diy scheduler manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceCommit", "generatedAt", "entries"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "route",
          "method",
          "auth",
          "schedule",
          "timeoutSeconds",
          "maxAttempts",
          "overlapPolicy",
          "sourceLocations"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "route": { "type": "string", "pattern": "^/api/" },
          "method": { "enum": ["GET", "POST"] },
          "auth": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scheme", "secretPurpose"],
            "properties": {
              "scheme": { "enum": ["raw-header", "bearer"] },
              "secretPurpose": { "enum": ["cron-api-key", "cron-secret"] }
            }
          },
          "schedule": { "type": "string", "minLength": 1 },
          "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
          "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 10 },
          "overlapPolicy": { "const": "forbid-per-tenant" },
          "sourceLocations": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
