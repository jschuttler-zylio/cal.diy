{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://withzylio.dev/schemas/booking/environment.v1.schema.json",
  "title": "Source-derived Cal.diy environment inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceCommit", "generatedAt", "variables"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "requirement", "source", "sensitivity", "ownership", "profiles"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "requirement": { "enum": ["required", "conditional", "forbidden"] },
          "source": { "enum": ["literal", "tenant-manifest", "bitwarden", "generated-runtime"] },
          "sensitivity": { "enum": ["public", "secret", "recovery-critical"] },
          "ownership": { "enum": ["zylioEnforced", "bootstrapDefaults", "clientMutable"] },
          "profiles": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["base"] }
          },
          "validation": { "type": "string" },
          "sourceLocations": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
